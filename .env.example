RUNTIME=node
DATABASE_URL=postgres://suan:suan@localhost:5432/suan

# Object storage (MinIO locally / R2 on Cloudflare via adapters)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=suan-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1

# LLM: test = local deterministic report (no API key needed)
LLM_MODE=test
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=test-model
VISION_MODEL=

# Jobs: when true, API process fires async jobs after response (dev only)
JOBS_INLINE=false
WORKER_POLL_MS=1500

# Cookie Secure: only for real HTTPS. Local Docker HTTP must be false/omit.
COOKIE_SECURE=false
# APP_URL=https://your.domain  # also enables Secure when https

# Admin console (/admin)
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-me-in-production

# Optional cache
REDIS_URL=
